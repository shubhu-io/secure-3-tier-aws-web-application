# Backend runtime configuration
# Copy to .env and fill in (NEVER commit .env)

# Port the API listens on
PORT=3000

# Node environment
NODE_ENV=development

# --- MySQL ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=appdb
DB_USER=app_user
DB_PASSWORD=local-dev-password
DB_POOL_MAX=10

# --- Auth ---
# Used to sign JWTs. In production this is injected from the SSM SecureString parameter.
JWT_SECRET=local-dev-secret-change-me-1234567890
JWT_EXPIRES_IN=8h

