# ============================================================================
# .env.aws.example  –  AWS deployment environment variables
#
# Usage:
#   cp .env.aws.example .env.aws
#   # Fill in YOUR values below
#   source .env.aws
#   make deploy-aws
#
# NEVER commit .env.aws — it is listed in .gitignore
# ============================================================================

# ── AWS credentials ───────────────────────────────────────────────────────────
# Option A: explicit keys (CI/CD or simple local use)
export AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
export AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY

# Option B: named profile (recommended for local dev)
# export AWS_PROFILE=my-profile

# ── Deployment target ─────────────────────────────────────────────────────────
export AWS_REGION=eu-west-1          # e.g. ap-south-1, us-east-1
export ENV_NAME=dev                  # dev | prod
export PROJECT=secure-ntier          # must match project_name in tfvars

# ── Terraform state backend ───────────────────────────────────────────────────
# The bootstrap-state.sh script creates this bucket + DynamoDB table automatically.
# Change to something globally unique (bucket names are global in S3).
export STATE_BUCKET=secure-ntier-dev-tfstate-$(aws sts get-caller-identity --query Account --output text 2>/dev/null || echo "ACCOUNTID")

# ── Image tag ─────────────────────────────────────────────────────────────────
# Defaults to current git short SHA if not set.
# export DEPLOY_TAG=v1.0.0

# ── ALB smoke test ────────────────────────────────────────────────────────────
# Set after first apply — terraform output app_url
# export ALB_URL=http://secure-ntier-dev-alb-xxxx.eu-west-1.elb.amazonaws.com

# ── Terraform variable overrides (optional) ───────────────────────────────────
# These override values in terraform/environments/dev/terraform.tfvars
# export TF_VAR_aws_instance_type=t3.small
# export TF_VAR_notification_email=you@example.com
# export TF_VAR_db_multi_az=false
