# ============================================================================
# DEV environment values
# Copy to terraform.tfvars and fill in YOUR values. Never commit terraform.tfvars.
#
#   cp terraform/environments/dev/terraform.tfvars.example \
#      terraform/environments/dev/terraform.tfvars
# ============================================================================

project_name = "secure-ntier"
environment  = "dev"
aws_region   = "eu-west-1"          # <YOUR_REGION>

# Optional: pin AZs explicitly, otherwise the first two available are used
# azs = ["eu-west-1a", "eu-west-1b"]

vpc_cidr           = "10.0.0.0/16"
public_subnet_cidrs = ["10.0.1.0/24", "10.0.2.0/24"]
app_subnet_cidrs    = ["10.0.11.0/24", "10.0.12.0/24"]
db_subnet_cidrs     = ["10.0.21.0/24", "10.0.22.0/24"]

nat_gateway_count = 1

instance_type          = "t3.micro"
asg_min_size           = 2
asg_max_size           = 4
asg_desired_capacity   = 2

db_instance_class     = "db.t3.micro"
db_multi_az           = false
db_allocated_storage  = 20
db_name               = "appdb"
db_username           = "app_user"
backup_retention_days = 7
deletion_protection   = false
skip_final_snapshot   = true

# Leave empty for a plain HTTP ALB (dev). For HTTPS, set your domain.
domain_name = ""                    # e.g. "app.example.com"

notification_email = "you@example.com"   # <YOUR_EMAIL> for alarms

repositories = ["backend", "frontend"]
