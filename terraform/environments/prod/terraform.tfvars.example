# ============================================================================
# PROD environment values
# Copy to terraform.tfvars and fill in YOUR values. Never commit terraform.tfvars.
# ============================================================================

project_name = "secure-ntier"
environment  = "prod"
aws_region   = "ap-south-1"          # Mumbai, India (ap-south-1)

vpc_cidr           = "10.0.0.0/16"
public_subnet_cidrs = ["10.0.1.0/24", "10.0.2.0/24"]
app_subnet_cidrs    = ["10.0.11.0/24", "10.0.12.0/24"]
db_subnet_cidrs     = ["10.0.21.0/24", "10.0.22.0/24"]

nat_gateway_count = 2   # one NAT per AZ for HA

aws_instance_type      = "t3.medium"
asg_min_size           = 2
asg_max_size           = 6
asg_desired_capacity   = 2

aws_db_instance_class = "db.t3.medium"
db_multi_az           = true
db_allocated_storage  = 50
db_name               = "appdb"
db_username           = "app_user"
backup_retention_days = 30
deletion_protection   = true
skip_final_snapshot   = false   # always snapshot before destroy in prod

domain_name = "app.example.com"      # <YOUR_DOMAIN> - REQUIRED for HTTPS in prod

notification_email = "ops@example.com"    # <YOUR_EMAIL>

repositories = ["backend", "frontend"]

# --- Kubernetes (optional, costly) ---
# Set to true to also provision an EKS cluster + managed node group.
aws_enable_eks = false

# IAM principal (user/role ARN) granted cluster admin for CI/CD kubectl.
# aws_eks_ci_iam_arn = "arn:aws:iam::123456789012:role/github-actions-cicd"

# --- Jenkins (optional, alternative to GitHub Actions) ---
# In prod, prefer GitHub Actions (managed) over self-hosted Jenkins unless you
# have a reason to run your own. If you do, LOCK the ingress CIDRs to your IPs.
aws_enable_jenkins = false
# aws_jenkins_ingress_cidrs = ["203.0.113.5/32"]
# aws_jenkins_key_name = "prod-jenkins-key"
