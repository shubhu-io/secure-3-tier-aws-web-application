{
  "project": "secure-ntier",
  "services": [
    {
      "name": "backend",
      "language": "node",
      "port": 3000,
      "public": false,
      "source_dir": "application/backend",
      "dockerfile": "docker/backend/Dockerfile",
      "toolchain": "node:22-alpine",
      "ci_steps": [
        { "name": "install", "command": "npm ci" },
        { "name": "test", "command": "npm test" },
        { "name": "audit", "command": "npm audit --audit-level=high" }
      ],
      "health_path": "/health"
    },
    {
      "name": "frontend",
      "language": "node",
      "port": 80,
      "public": true,
      "source_dir": "application/frontend",
      "dockerfile": "docker/frontend/Dockerfile",
      "toolchain": "node:22-alpine",
      "ci_steps": [
        { "name": "install", "command": "npm ci" },
        { "name": "build", "command": "npm run build" }
      ],
      "health_path": "/health"
    }
  ],
  "database": {
    "engine": "postgres",
    "engine_version": "16.4",
    "port": 5432
  },
  "runtime": ["ec2-compose", "eks"],
  "clouds": ["aws", "azure", "gcp"],
  "default_cloud": "aws",
  "cloud_config": {
    "aws":   { "region": "eu-west-1",    "registry": "ecr",              "kubernetes": "eks" },
    "azure": { "region": "westeurope",   "registry": "acr",              "kubernetes": "aks" },
    "gcp":   { "region": "europe-west1", "registry": "artifact-registry","kubernetes": "gke" }
  }
}