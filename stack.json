{
  "project": "secure-ntier",
  "services": [
    {
      "name": "backend",
      "language": "node",
      "port": 3000,
      "public": false,
      "source_dir": "application/backend",
      "dockerfile": "docker/backend/Dockerfile",
      "toolchain": "node:22-alpine",
      "ci_steps": [
        { "name": "install", "command": "npm ci" },
        { "name": "test", "command": "npm test" }
      ],
      "health_path": "/health"
    },
    {
      "name": "frontend",
      "language": "node",
      "port": 80,
      "public": true,
      "source_dir": "application/frontend",
      "dockerfile": "docker/frontend/Dockerfile",
      "toolchain": "node:22-alpine",
      "ci_steps": [
        { "name": "install", "command": "npm ci" },
        { "name": "build", "command": "npm run build" }
      ],
      "health_path": "/health"
    }
  ],
  "database": {
    "engine": "mysql",
    "engine_version": "8.0",
    "port": 3306
  },
  "runtime": ["ec2-compose"],
  "clouds": ["aws"],
  "cloud_config": {
    "aws": { "region": "ap-south-1", "registry": "ecr" }
  }
}