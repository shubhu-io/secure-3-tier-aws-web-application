// ============================================================================
// Jenkinsfile - Application deploy pipeline (alternative to GitHub Actions)
//
// Trigger: GitHub webhook to this job (push to main) or manual build with a
//          parameter. Mirrors `.github/workflows/deploy.yml` exactly:
//
//   Checkout → CI (test + audit + build + trivy, per stack.json service)
//     → Registry login → Push every service → VM fleet rollout
//       (AWS ASG / Azure VMSS / GCP MIG, per CLOUD)
//     → (optional) Deploy to managed k8s (EKS/AKS/GKE) → Smoke test
//
// Agent requirements (see cicd/jenkins/README.md for setup):
//   - a Linux agent labelled "docker" with: bash, git, docker, jq and the
//     active cloud's CLI (aws | az | gcloud)
//   - kubectl (only needed when DEPLOY_K8S=true)
//   - node/npm, trivy etc. run inside containers (no agent-side installs)
//
// Credentials (Jenkins → Manage Jenkins → Credentials → Global) - OPTIONAL:
//   aws-access-key-id      (Secret text) = AWS Access Key ID
//   aws-secret-access-key  (Secret text) = AWS Secret Access Key
// If these two credentials are absent, the pipeline falls back to the agent's
// AWS instance role (the Terraform Jenkins module provides one automatically).
// For azure/gcp the agent needs `az login` / `gcloud auth` (or instance roles).
// ============================================================================

pipeline {
  agent { label 'docker && linux' }

  options {
    timestamps()
    disableConcurrentBuilds()               // no two deploys at once
    timeout(time: 30, unit: 'MINUTES')
    buildDiscarder(logRotator(numToKeepStr: '20'))
    skipDefaultCheckout()
  }

  parameters {
    choice(name: 'CLOUD', choices: ['aws', 'azure', 'gcp'],
           description: 'Target cloud (aws | azure | gcp)')
    choice(name: 'ENVIRONMENT', choices: ['dev', 'prod'],
           description: 'Target environment (dev applies the cheaper stack)')
    string(name: 'REGION', defaultValue: '',
           description: 'Region of the active cloud. Empty = stack.json cloud_config region.')
    string(name: 'PROJECT', defaultValue: 'secure-ntier',
           description: 'Project name used in resource/registry naming')
    booleanParam(name: 'AUTO_DEPLOY', defaultValue: true,
           description: 'Push images and roll the VM fleet (ASG / VMSS / MIG)')
    string(name: 'IMAGE_TAG', defaultValue: '',
           description: 'Image tag to build & deploy. Empty = current git SHA.')
    string(name: 'ALB_URL', defaultValue: '',
           description: 'URL to smoke-test after deploy, e.g. http://...elb.amazonaws.com . Empty = skip smoke test.')
    booleanParam(name: 'DEPLOY_K8S', defaultValue: false,
           description: 'Also deploy to the managed k8s cluster (EKS/AKS/GKE - requires Terraform enable_eks/aks/gke=true + kubectl on the agent)')
    string(name: 'K8S_CLUSTER', defaultValue: '',
           description: 'Cluster name. Empty = <project>-<env>-<eks|aks|gke>.')
  }

  environment {
    CLOUD      = "${params.CLOUD}"
    ENV        = "${params.ENVIRONMENT}"
    PROJECT    = "${params.PROJECT}"
  }

  stages {
    stage('Checkout') {
      steps {
        checkout scm
        script {
          // Resolve the tag: explicit parameter wins, else short git SHA.
          env.IMAGE_TAG = params.IMAGE_TAG ?: GIT_COMMIT.take(7)
          echo "Building image tag: ${env.IMAGE_TAG} for cloud ${params.CLOUD}"

          // Region: explicit parameter wins, else the active cloud's
          // region from stack.json cloud_config.
          env.REGION = params.REGION ?: sh(
            script: "bash cicd/scripts/stack-info.sh cloud-field region",
            returnStdout: true).trim()
          echo "Using region: ${env.REGION}"

          // AWS credentials are OPTIONAL. When the Jenkins credentials exist
          // they are used; otherwise the pipeline relies on the agent's AWS
          // instance role (IMDSv2) - no keys anywhere.
          try {
            env.AWS_ACCESS_KEY_ID = credentials('aws-access-key-id')
            env.AWS_SECRET_ACCESS_KEY = credentials('aws-secret-access-key')
            echo "Using Jenkins credentials 'aws-access-key-id' + 'aws-secret-access-key'"
          } catch (Exception e) {
            echo "No 'aws-access-key-id' credential found - using the agent's AWS instance role"
          }
        }
      }
    }

    stage('CI (test + audit + build + scan)') {
      // Generic: runs every service's ci_steps in its declared toolchain
      // container, builds its image and trivy-scans it - driven by stack.json.
      steps {
        sh "bash cicd/scripts/stack-ci.sh ${PROJECT}"
      }
    }

    stage('Static analysis (SonarQube, optional)') {
      // Runs only when a SONAR_HOST_URL is available; the code-quality gate
      // does not block deploys by default (set sonar.qualitygate.wait=true
      // in sonar-project.properties to enforce it).
      when { expression { env.SONAR_HOST_URL != null } }
      steps {
        withSonarQubeEnv('SonarQube') {
          sh "sonar-scanner -Dsonar.projectBaseDir=${WORKSPACE}"
        }
      }
    }

    stage('Registry login (ECR / ACR / Artifact Registry)') {
      steps {
        sh "bash cicd/scripts/registry-login.sh ${env.REGION}"
      }
    }

    stage('Push images') {
      when { expression { params.AUTO_DEPLOY == true } }
      steps {
        sh "bash cicd/scripts/stack-push.sh ${env.IMAGE_TAG} ${env.REGION} ${PROJECT} ${ENV}"
      }
    }

    stage('Deploy (VM fleet rollout: ASG / VMSS / MIG)') {
      when { expression { params.AUTO_DEPLOY == true } }
      steps {
        script {
          // One deploy script per cloud - all take the same arguments.
          def deployScripts = [aws: 'deploy-ec2.sh', azure: 'deploy-vmss.sh', gcp: 'deploy-mig.sh']
          sh "bash cicd/scripts/${deployScripts[params.CLOUD]} ${env.IMAGE_TAG} ${env.REGION} ${ENV} ${PROJECT}"
        }
      }
    }

    stage('Deploy to Kubernetes (kubectl)') {
      when { expression { params.AUTO_DEPLOY == true && params.DEPLOY_K8S == true } }
      steps {
        script {
          if (params.K8S_CLUSTER) {
            env.K8S_CLUSTER = params.K8S_CLUSTER
          } else {
            def suffix = [aws: 'eks', azure: 'aks', gcp: 'gke'][params.CLOUD]
            env.K8S_CLUSTER = "${params.PROJECT}-${params.ENVIRONMENT}-${suffix}"
          }
        }
        sh "bash cicd/scripts/deploy-k8s.sh ${env.IMAGE_TAG} ${env.REGION} ${ENV} ${PROJECT} ${env.K8S_CLUSTER}"
      }
    }

    stage('Smoke test') {
      when { expression { params.AUTO_DEPLOY == true && params.ALB_URL != '' } }
      steps {
        withEnv(["ALB_URL=${params.ALB_URL}", "ATTEMPTS=36"]) {
          sh "bash cicd/scripts/smoke-test.sh"
        }
      }
    }
  }

  post {
    always {
      // Tidy the locally-built CI images so the agent never fills up.
      script {
        def services = sh(script: "bash cicd/scripts/stack-info.sh list", returnStdout: true).trim().split('\\n')
        for (svc in services) {
          sh "docker rmi ${PROJECT}-${svc}:ci 2>/dev/null || true"
        }
      }
      cleanWs(deleteDirs: true)
    }
    failure {
      // Requires the Email Extension / Slack plugin configured on the master.
      // emailext(to: 'devops@example.com',
      //         subject: "BUILD FAILED: \${PROJECT}-\${ENV}",
      //         body: "See \${BUILD_URL}console")
      echo "!!! Deploy pipeline FAILED for ${PROJECT}-${ENV}"
    }
    success {
      echo ">>> Deploy pipeline OK for ${PROJECT}-${ENV} @ ${env.IMAGE_TAG}"
    }
  }
}