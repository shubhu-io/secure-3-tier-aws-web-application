# ============================================================================
# TEMPLATE ONLY - DO NOT APPLY AS-IS.
#
# The real app-db-secret is materialized at deploy time by
# kubernetes/scripts/deploy.sh, which reads the DB credentials from AWS
# Secrets Manager and creates the secret with:
#
#   kubectl create secret generic app-db-secret \
#     --namespace secure-ntier \
#     --from-literal=DB_HOST=... \
#     --from-literal=DB_PORT=5432 \
#     --from-literal=DB_NAME=... \
#     --from-literal=DB_USER=... \
#     --from-literal=DB_PASSWORD=... \
#     --from-literal=JWT_SECRET=... \
#     --dry-run=client -o yaml | kubectl apply -f -
#
# The placeholder below documents the expected keys. Replace the values
# (base64-encoded) ONLY for a self-contained demo/local cluster.
# ============================================================================
apiVersion: v1
kind: Secret
metadata:
  name: app-db-secret
  namespace: secure-ntier
type: Opaque
stringData:
  DB_HOST: "change-me"
  DB_PORT: "5432"
  DB_NAME: "appdb"
  DB_USER: "app_user"
  DB_PASSWORD: "change-me"
  JWT_SECRET: "change-me"
