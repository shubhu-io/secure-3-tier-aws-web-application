%% ============================================================================
%% Diagram 5 - Request flow
%% Purpose: exact path of a user request through every layer
%% ============================================================================
sequenceDiagram
    participant B as Browser
    participant DNS as Route 53
    participant W as WAF
    participant L as ALB
    participant T as Target Group
    participant EC as EC2 (nginx)
    participant N as Backend node
    participant D as RDS PostgreSQL

    B->>DNS: https://app.example.com
    DNS-->>B: ALB DNS name (A record alias)
    B->>W: HTTPS request :443
    W->>W: managed rules (SQLi/XSS/bots) - block or allow
    W->>L: allowed request
    L->>L: TLS termination, parse path
    L-->>EC: / -> forward to app target group :80
    L-->>EC: /api/items -> forward :80
    EC->>EC: nginx serves static SPA for /
    EC->>N: /api/* proxied to backend:3000
    N->>D: SQL query (pool, app secret)
    D-->>N: rows
    N-->>EC: JSON response
    EC-->>L: HTTP response
    L-->>B: HTTPS response