%% ============================================================================
%% Diagram 3 - Security architecture (defense in depth)
%% Purpose: every layer of protection between the internet and the database
%% ============================================================================
flowchart TD
    INTERNET[Internet] -->|"Only 443/80 to ALB"| WAF
    WAF[AWS WAF<br/>CloudFront/ALB managed rule groups<br/>SQLi, XSS, bad bots, IP reputation] -->|"verified TLS 1.2+"| ALBSG
    ALBSG[ALB Security Group<br/>inbound: 443/80 from 0.0.0.0/0]
    ALBSG -->|"source = ALB SG only"| APPSG
    APPSG[App Security Group<br/>inbound: 80 from ALB SG<br/>NO SSH from internet - SSM only]
    APPSG -->|"source = App SG only, port 5432"| DBSG
    DBSG[DB Security Group<br/>inbound: 5432 from App SG]

    subgraph AES[Application encryption]
        TLS[TLS/SSL via ACM certificate]
        KMS[KMS/encrypted EBS gp3]
    end

    subgraph IDS[Identity + secrets]
        IAM[IAM roles: least privilege<br/>instance role, CI/CD role]
        SEC[Secrets Manager: DB creds,<br/>no secrets in code or Git]
    end

    subgraph APPDEF[App - network defense]
        NACL[NACLs per tier - stateless]
        ROUTE[Private subnets: no public IPs]
        IMDS[IMDSv2 required]
    end

    subgraph AUD[Auditing]
        CLOUDTRAIL[CloudTrail - API audit]
        FLOW[VPC Flow Logs → CloudWatch]
    end