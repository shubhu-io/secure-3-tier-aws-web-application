%% ============================================================================
%% Diagram 1 - Overall architecture (big picture)
%% Purpose: end-to-end view of the platform - request path, CI/CD deploy path,
%%          and the security / observability layers around them.
%% Render in Mermaid Live Editor or with mermaid-cli (mmdc).
%% ============================================================================
flowchart TD
    %% ===================== Request path =====================
    U[Internet User] --> R53[Route 53 DNS<br/>app.example.com]
    R53 --> WAF[AWS WAF<br/>SQLi / XSS / bad bots]
    WAF --> ALB[Application Load Balancer<br/>HTTPS :443, HTTP->HTTPS]

    subgraph VPC["VPC 10.0.0.0/16"]
        subgraph PUB["Public subnets 10.0.1.0/24, 10.0.2.0/24"]
            ALB
            NAT[["NAT Gateway"]]
            IGW[Internet Gateway]
        end

        subgraph APP["Private app subnets 10.0.11.0/24, 10.0.12.0/24"]
            ASG[Auto Scaling Group<br/>min 2 / max 4 across AZs]
            A1[EC2 App AZ-a<br/>Docker: nginx + node]
            A2[EC2 App AZ-b<br/>Docker: nginx + node]
        end

        subgraph DBT["Private DB subnets 10.0.21.0/24, 10.0.22.0/24"]
            RDS[(RDS PostgreSQL<br/>encrypted, private)]
        end

        ALB --> A1
        ALB --> A2
        A1 --> RDS
        A2 --> RDS
        NAT -.outbound only.-> IGW
        APP -.packages via NAT.-> NAT
    end

    IGW --> ALB
    ASG -.launches & replaces.-> A1
    ASG -.launches & replaces.-> A2

    %% ===================== CI/CD deploy path =====================
    DEV[Developer] --> SCM{{GitHub / Jenkins}}
    SCM --> ECR[["ECR repositories<br/>backend + frontend"]]
    SCM -->     SSM[SSM image parameter<br/>deploy pointer]
    SSM --> ASG
    ASG -.start instance refresh.-> A1
    ASG -.start instance refresh.-> A2
    ECR -.pull image at boot.-> A1
    ECR -.pull image at boot.-> A2

    %% ===================== Secrets =====================
    SM[AWS Secrets Manager<br/>DB credentials + JWT] -.read at boot.-> A1
    SM -.read at boot.-> A2

    %% ===================== Observability & audit =====================
    CW[CloudWatch<br/>alarms + logs] -.metrics/logs.-> ALB
    CW -.metrics/logs.-> A1
    CW -.metrics/logs.-> RDS
    CW --> SNS[SNS alerts] --> EMAIL[(ops email)]

    CT[CloudTrail<br/>multi-region] --> S3[(audit log bucket<br/>encrypted)]

    %% ===================== Optional Kubernetes =====================
    EKS[EKS cluster<br/>optional, opt-in] -.node SG trusted by.-> RDS
