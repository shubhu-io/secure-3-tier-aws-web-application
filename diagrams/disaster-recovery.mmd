%% ============================================================================
%% Diagram 8 - Disaster recovery
%% Purpose: how we define and meet RTO / RPO, and recover from a full loss
%% ============================================================================
flowchart TD
    DISASTER[Region / AZ catastrophe] --> RDS_FAIL
    DISASTER --> INFRA_LOSS[Full infrastructure lost]
    DISASTER --> AWS_REPLICATED[RDS Multi-AZ or restore from snapshot]

    subgraph DATA[Data recovery]
        RDS_FAIL[RDS Multi-AZ failover<br/>RPO ≈ 0, RTO minutes] 
        SNAP[RDS automated backups<br/>retention 7 days<br/>RPO up to 5 min old - point-in-time]
        RESTORE[Restore: create new DB from snapshot<br/>aws rds restore-db-instance-from-db-snapshot]
    end

    subgraph INFRA[Infrastructure recovery]
        INFRA_LOSS --> STATE[Terraform state in S3 + DynamoDB lock]
        STATE --> TF[terraform plan / apply - rebuild everything]
        TF --> ECR_F[Images rebuilt or re-pulled from ECR]
        TF --> CICD[CI/CD re-deploy app]
    end

    DATA --> VERIFY[Verify: health endpoint + data checks]
    INFRA --> VERIFY

    subgraph METRICS[Recovery targets]
        RTO["RTO = time to recover (target: < 60 min)"]
        RPO["RPO = data we can lose (target: 5 min)"]
    end