# ============================================================================
# Secure-NTier  Docker environment overrides
#
# Copy to a real .env file in this directory and adjust for your machine:
#   cp docker/.env.example docker/.env
#   (docker/.env is gitignored - NEVER commit a real .env)
#
# docker compose reads docker/.env automatically for ${VAR} interpolation.
# Every value specified here has a safe default baked into docker-compose.yml,
# so the stack also runs with no .env at all. Fill this in when you want to
# change ports, the DB or JWT secret, the environment, or production images.
# ============================================================================

# --- Runtime environment ------------------------------------------------------
# development (local) or production.
NODE_ENV=development

# --- Auth ---------------------------------------------------------------------
# JWT signing secret. CHANGE THIS for anything beyond a single-dev laptop.
# In real deployments this is injected from the SSM SecureString parameter (see
# terraform/cloud/aws/modules/compute/user-data.sh).
JWT_SECRET=local-dev-secret-change-me-1234567890

# --- Database (local dev stack only) -----------------------------------------
# These are read by BOTH the mysql container and the backend service, so
# only change them in pairs.
DB_NAME=appdb
DB_USER=app_user
DB_PASSWORD=local-dev-password

# --- Port maps (host:container) ----------------------------------------------
# Surface the exposed ports on different host ports if 3306/3000/80 are taken.
DB_PORT_MAP=3306
BACKEND_PORT_MAP=3000
FRONTEND_PORT_MAP=80

# --- Production compose (docker-compose.prod.yml) ------------------------------
# Full image references to pull. ECR example:
#   BACKEND_IMAGE=012345678901.dkr.ecr.ap-south-1.amazonaws.com/secure-ntier-dev-backend:latest
#   FRONTEND_IMAGE=012345678901.dkr.ecr.ap-south-1.amazonaws.com/secure-ntier-dev-frontend:latest
# If unset, the prod compose looks for locally-tagged images with those names.
# BACKEND_IMAGE=secure-ntier-backend:latest
# FRONTEND_IMAGE=secure-ntier-frontend:latest

# Production DB connectivity (NOT used by the local stack). Set these to the
# managed database endpoint when running docker-compose.prod.yml.
# DB_HOST=db.example.c7abcdefg.eu-west-1.rds.amazonaws.com
# DB_PORT=3306
