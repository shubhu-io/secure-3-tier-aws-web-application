# ===========================================================================
# secure-ntier-cloud-platform - .gitignore
# NEVER commit secrets, state files, or build artifacts.
# ===========================================================================

# --- Secrets & Credentials --------------------------------------------------
.env
.env.*
!.env.example
!.env.aws.example
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
credentials.json
*credentials*
secrets.yaml
*.tfvars
!terraform.tfvars.example
*.tfvars.json

# --- Terraform --------------------------------------------------------------
.terraform/
*.tfstate
*.tfstate.*
crash.log
override.tf
override.tf.json
terraform.tfvars

# --- Node / Frontend --------------------------------------------------------
node_modules/
npm-debug.log*
yarn-error.log*
dist/
build/
coverage/
.vite/

# --- Docker --------------------------------------------------------------
*.pid

# --- Logs -------------------------------------------------------------------
logs/
*.log
*.log.*

# --- OS / Editor ------------------------------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# --- Large / Generated ------------------------------------------------------
# ignore loose images at screenshots/ root, allow subfolders (deployment/, cicd/, etc.)
screenshots/*.png
screenshots/*.jpg
screenshots/*.jpeg
*.tar
*.zip
*.tgz

# --- Cloud-native local caches ----------------------------------------------
.terraform.tfstate.lock.info
terraform.tfstate.backup

# --- Generated / Local ------------------------------------------------------
tree_output.txt
PROPOSED_STRUCTURE.md
MULTI-CLOUD-DEPLOYMENT.md
SETUP-GUIDE.md
__pycache__/
*.pyc
dist-test/
examples/programming/typescript/dist/
examples/programming/typescript/dist-test/

# --- Programming examples build artifacts -----------------------------------
examples/programming/csharp/bin/
examples/programming/csharp/obj/
examples/programming/kotlin/.gradle/
examples/programming/kotlin/build/
examples/programming/java-gradle/.gradle/
examples/programming/java-gradle/build/
examples/programming/rust/target/
examples/programming/rust/Cargo.lock
examples/programming/scala/target/
examples/programming/swift/.build/
